# 全部文本一律 LF 入库。
# Windows 上 autocrlf 会把 .sh 改成 CRLF，刷进手机就是
# "#!/system/bin/sh^M: bad interpreter"，整个模块起不来。
* text=auto eol=lf

*.sh            text eol=lf
*.prop          text eol=lf
*.md            text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.json          text eol=lf
*.py            text eol=lf
*.xml           text eol=lf
*.yml           text eol=lf

# 刷机脚本没有扩展名，单独点名
customize.sh              text eol=lf
apply.sh                  text eol=lf
uninstall.sh              text eol=lf
META-INF/com/google/android/update-binary   text eol=lf
META-INF/com/google/android/updater-script  text eol=lf

# 系统字体配置：体积大、非手写代码，不参与语言统计
system/etc/fonts.xml linguist-vendored
system/system_ext/etc/fonts_base.xml linguist-vendored
system/system_ext/etc/fonts_ule.xml linguist-vendored

# 字体与二进制
*.ttf binary
*.otf binary
*.ttc binary
*.so binary
*.whl binary

# 截图
docs/screenshots/*.png binary
